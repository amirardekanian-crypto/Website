            ]
          },
          "note": "Land quiet — you should hear almost nothing."
        },
        {
          "type": "standard",
          "name": "Sprint to Two-Step Stop",
          "videoUrl": null,
          "restSec": 60,
          "chips": [
            {
              "label": "5 Sets",
              "style": "yellow"
            },
            {
              "label": "×10 m"
            }
          ],
          "cues": {
            "good": [
              "Accelerate hard, then kill it in two steps and hold the stance",
              "The last two steps get wider and lower"
            ],
            "bad": [
              "Slowing down gradually over five or six steps"
            ]
          },
          "note": "Own the stop before you make it faster."
        }
      ]
    },
