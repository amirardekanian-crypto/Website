      "exercises": [
        {
          "type": "simple",
          "name": "Easy Jog",
          "videoUrl": null,
          "chips": [
            { "label": "3 minutes", "style": "dark" }
          ],
          "cues": {
            "good": [
              "Easy pace until you are warm and breathing"
            ],
            "bad": [
              "Going straight into the fast stuff cold"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Side Shuffle",
          "videoUrl": null,
          "chips": [
            { "label": "4 Lengths" },
            { "label": "Service line to service line" }
          ],
          "cues": {
            "good": [
              "Stay low, push the ground away with the trailing foot",
              "Face the net the whole way"
            ],
            "bad": [
              "Bobbing up and down between steps",
              "Crossing the feet"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Carioca",
          "videoUrl": null,
          "chips": [
            { "label": "2 Lengths / side" }
          ],
          "cues": {
            "good": [
              "Let the hips rotate and keep the shoulders quiet",
              "Build the speed across the length"
            ],
            "bad": [
              "Turning the whole body and making it a run"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Split-Step Bounces",
          "videoUrl": null,
          "chips": [
            { "label": "3 Sets" },
            { "label": "×6 Reps" }
          ],
          "cues": {
            "good": [
              "Small hop, land wide and low on the balls of both feet",
              "Land already loaded, ready to push either way"
            ],
            "bad": [
              "A big jump that leaves you in the air when the ball is struck"
            ]
          }
        }
      ]
    },
    {
      "title": "Reaction",
      "icon": "⚡",
      "exercises": [
        {
          "type": "standard",
          "name": "Wall Feed Reaction",
          "videoUrl": null,
          "restSec": 60,
          "chips": [
            { "label": "6 Sets", "style": "yellow" },
            { "label": "×5 Balls" }
          ],
          "cues": {
            "good": [
              "Throw the ball hard at the wall, split-step, then move to where it comes off",
              "Vary how hard you throw so you cannot predict the bounce",
              "Get there and set your feet — catching it flat-footed does not count"
            ],
            "bad": [
              "Throwing the same ball to the same spot every time",
              "Guessing and moving before the ball leaves the wall"
            ]
          }
        },
        {
          "type": "standard",
          "name": "Self-Drop Drop-Step",
          "videoUrl": null,
          "restSec": 45,
          "chips": [
            { "label": "4 Sets", "style": "yellow" },
            { "label": "3 each side" }
          ],
          "cues": {
            "good": [
              "Hold the ball at shoulder height behind you, drop it and chase it down",
              "First move is the drop-step — open the hip, do not step across",
              "Catch it before the second bounce"
            ],
            "bad": [
              "Turning your back and running — stay open to the court",
              "Setting off before you let go of the ball"
            ]
          }
        }
      ]
    },
    {
      "title": "Quickness",
      "icon": "👟",
      "exercises": [
        {
          "type": "circuit",
          "name": "Line Drill",
          "rounds": "3 Rounds",
          "restSec": 60,
          "items": [
            {
              "name": "Lateral Line Hops",
              "detail": "15 seconds",
              "cues": {
                "good": ["Two feet over the line and back, as fast as you can cycle them"],
                "bad": ["Looking down at the line"]
              }
            },
            {
              "name": "Front-Back Line Hops",
              "detail": "15 seconds",
              "cues": {
                "good": ["Tiny hops, stiff ankles, stay on the balls of the feet"],
                "bad": ["Jumping high instead of fast"]
              }
            },
            {
              "name": "Shadow Change of Direction",
              "detail": "20 seconds",
              "cues": {
                "good": [
                  "Split-step, move to a corner, recover to the middle, repeat",
                  "Pick the corner late — make yourself react, not rehearse"
                ],
                "bad": ["Falling into the same left-right-left pattern every round"]
              }
            }
          ]
        }
      ]
    }
  ]
}
