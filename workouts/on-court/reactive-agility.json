{
  "id": "reactive-agility",
  "title": "Split Second",
  "category": "on-court",
  "countsAs": "strength",
  "duration": "20 min",
  "equipment": "Court",
  "focusTag": "Reaction & Quickness",
  "intro": [
    "Quickness you cannot rehearse. Every drill here makes you react to something rather than run a pattern you already know.",
    "All of it works alone, off a wall or a ball you drop yourself. Vary the throws so you cannot predict the bounce — the moment it becomes predictable it is footwork practice, not reaction."
  ],
  "blocks": [
    {
      "title": "Activation & Prep",
      "icon": "🔥",
      "exercises": [
        {
          "type": "simple",
          "name": "Easy Jog",
          "videoUrl": null,
          "chips": [
            {
              "label": "3 minutes",
              "style": "dark"
            }
          ],
          "cues": {
            "good": [
              "Easy pace until you are warm and breathing",
              "Nothing here is fast yet"
            ],
            "bad": [
              "Starting hard — you are about to sprint"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Side Shuffle",
          "videoUrl": null,
          "chips": [
            {
              "label": "4 Lengths"
            },
            {
              "label": "Service line to service line"
            }
          ],
          "cues": {
            "good": [
              "Stay low and push the ground away with the trailing foot",
              "Face the net the whole way"
            ],
            "bad": [
              "Bobbing up and down between steps"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Carioca",
          "videoUrl": null,
          "chips": [
            {
              "label": "2 Lengths / side"
            }
          ],
          "cues": {
            "good": [
              "Let the hips rotate and keep the shoulders quiet",
              "Build the speed across the length"
            ],
            "bad": [
              "Turning the whole body and making it a run"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Split-Step Bounces",
          "videoUrl": null,
          "chips": [
            {
              "label": "3 Sets"
            },
            {
              "label": "×6 Reps"
            }
          ],
          "cues": {
            "good": [
              "Small hop, land wide and low on the balls of both feet",
              "Land already loaded, ready to push either way"
            ],
            "bad": [
              "A big jump that leaves you in the air when the ball is struck"
            ]
          }
        }
      ]
    },
    {
      "title": "Reaction",
      "icon": "⚡",
      "exercises": [
        {
          "type": "standard",
          "name": "Wall Feed Reaction",
          "videoUrl": null,
          "restSec": 60,
          "chips": [
            {
              "label": "6 Sets",
              "style": "yellow"
            },
            {
              "label": "×5 Balls"
            }
          ],
          "cues": {
            "good": [
              "Throw hard at the wall, split-step, then move to where it comes off",
              "Get there and set your feet"
            ],
            "bad": [
              "Throwing the same ball to the same spot every time"
            ]
          },
          "note": "Vary how hard you throw so you cannot predict the bounce."
        },
        {
          "type": "standard",
          "name": "Self-Drop Drop-Step",
          "videoUrl": null,
          "restSec": 45,
          "chips": [
            {
              "label": "4 Sets",
              "style": "yellow"
            },
            {
              "label": "3 each side"
            }
          ],
          "cues": {
            "good": [
              "Drop the ball from shoulder height behind you and chase it down",
              "First move is the drop-step — open the hip"
            ],
            "bad": [
              "Turning your back and running"
            ]
          }
        }
      ]
    },
    {
      "title": "Quickness",
      "icon": "👟",
      "exercises": [
        {
          "type": "circuit",
          "name": "Line Drill",
          "rounds": "3 Rounds",
          "restSec": 60,
          "items": [
            {
              "name": "Lateral Line Hops",
              "detail": "15 seconds",
              "cues": {
                "good": [
                  "Two feet over the line and back, as fast as you can cycle them",
                  "Stay on the balls of the feet"
                ],
                "bad": [
                  "Looking down at the line"
                ]
              }
            },
            {
              "name": "Front-Back Line Hops",
              "detail": "15 seconds",
              "cues": {
                "good": [
                  "Tiny hops over the line and back",
                  "Stiff ankles, light contacts"
                ],
                "bad": [
                  "Jumping high instead of fast"
                ]
              }
            },
            {
              "name": "Shadow Change of Direction",
              "detail": "20 seconds",
              "cues": {
                "good": [
                  "Split-step, move to a corner, recover to the middle, repeat",
                  "Pick the corner late"
                ],
                "bad": [
                  "Falling into the same left-right-left pattern every round"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
