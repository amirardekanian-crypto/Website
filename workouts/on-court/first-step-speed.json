  "intro": [
    "Twenty-five minutes on the first two steps. Ten of that is the warm-up, and that is not padding — you cannot sprint off a cold hip.",
    "Full rest between every effort. This is a speed session, so quality is the whole point; the moment you shorten the rest it becomes conditioning and stops training speed."
  ],
  "before": [
    {
      "label": "Not today",
      "text": "A sore ankle, knee, calf, hamstring, groin or Achilles, or an injury in the last month? Get it looked at first."
    },
    {
      "label": "Stop and get it checked",
      "text": "A sharp pain, pain that spreads, numbness, swelling, a joint that gives way, or a sudden pull or pop."
    },
    {
      "label": "Stop now",
      "text": "Chest pain, dizziness, a heartbeat that races or skips, or breathing that doesn't feel right. Get it looked at before you train again. Told to be careful with hard exercise? Check with your doctor first."
    },
    {
      "label": "Past injury",
      "text": "Ever torn a hamstring, or coming back from a knee or ankle injury? Ask whoever treated you if sprinting is OK."
    },
    {
      "label": "Check the space",
      "text": "About twenty-five metres of flat, non-slip ground, and court shoes. Mark each distance with tape or a line, not cones or bags you could step on."
    },
    {
      "label": "Keep clear",
      "text": "48 hours away from another hard session, and not the day before a match."
    },
    {
      "label": "First time",
      "text": "Do three split-step sprints instead of six, and two falling starts instead of four."
    }
  ],
