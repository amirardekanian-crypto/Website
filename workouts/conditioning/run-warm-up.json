                ]
              }
            },
            {
              "name": "Pogo Hop",
              "detail": "×20",
              "cues": {
                "good": [
                  "Stiff ankles, off the ground as fast as you land",
                  "Quiet contacts"
                ],
                "bad": [
                  "Bending the knees and turning it into a squat jump"
                ]
              }
            },
            {
              "name": "A-Skip",
              "detail": "20m",
              "cues": {
                "good": [
                  "Tall hips, strike the ground underneath you",
                  "Rhythm first, height second"
                ],
                "bad": [
