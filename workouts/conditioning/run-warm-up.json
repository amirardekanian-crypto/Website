            ],
            "bad": [
              "Letting the knee roll inward"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Walking Hamstring Sweep",
          "videoUrl": null,
          "chips": [
            {
              "label": "×6 Each Side"
            }
          ],
          "cues": {
            "good": [
              "Step onto a straight leg and sweep the hands down the shin",
