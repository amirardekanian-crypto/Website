            ]
          }
        },
        {
          "type": "simple",
          "name": "Lateral Lunge",
          "videoUrl": null,
          "chips": [
            {
              "label": "×6 Each Side"
            }
          ],
          "cues": {
            "good": [
              "Step wide and sit into that hip, chest tall",
