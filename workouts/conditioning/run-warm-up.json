            ]
          }
        },
        {
          "type": "simple",
          "name": "Side-to-Side Leg Swing",
          "videoUrl": null,
          "chips": [
            {
              "label": "×10 Each Side"
            }
          ],
          "cues": {
            "good": [
              "Swing the leg across the body and back out",
              "Keep the hips facing forward"
            ],
            "bad": [
              "Twisting the whole torso with it"
            ]
          }
        }
      ]
    },
    {
