      "title": "Raise",
      "icon": "🔥",
      "exercises": [
        {
          "type": "simple",
          "name": "Easy Jog",
          "videoUrl": null,
          "chips": [
            {
              "label": "3 min"
            }
          ],
          "cues": {
            "good": [
              "Easy pace until you are warm and breathing",
              "Nothing here is fast yet"
            ],
            "bad": [
              "Starting at running pace"
            ]
          }
        }
      ]
    },
    {
      "title": "Mobilize",
      "icon": "🧘",
      "exercises": [
        {
          "type": "simple",
          "name": "Walking Lunge with Overhead Reach",
          "videoUrl": null,
          "chips": [
            {
              "label": "×6 Each Side"
            }
          ],
          "cues": {
            "good": [
              "Step into a long lunge and reach both arms overhead",
              "Feel the front of the back hip open"
            ],
            "bad": [
