                ],
                "bad": [
                  "Crashing the back knee into the floor"
                ]
              }
            },
            {
              "name": "Fast Feet on the Spot",
              "detail": "20 seconds",
              "cues": {
                "good": [
                  "Tiny, quick contacts on the balls of the feet",
