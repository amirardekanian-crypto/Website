              "name": "Mountain Climber",
              "detail": "20 seconds",
              "cues": {
                "good": [
                  "Hands under the shoulders, drive the knees fast",
                  "Hips stay level"
                ],
                "bad": [
                  "Bouncing the hips up and down"
                ]
              }
            },
            {
              "name": "Reverse Lunge",
              "detail": "20 seconds, alternating",
              "cues": {
                "good": [
                  "Step back and drop the back knee softly",
