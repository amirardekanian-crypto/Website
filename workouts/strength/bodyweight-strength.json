  "intro": [
    "Full body with nothing but the floor. Built for a hotel room, a park, or a week when the gym is not happening.",
    "Legs lead, pressing stays light, and there is a set of prone raises to balance out all the pressing your shoulder already does on court."
  ],
  "before": [
    {
      "label": "Not today",
      "text": "A sore knee, ankle, hip, shoulder or wrist, or an injury in the last month? Get it looked at first."
    },
    {
      "label": "Stop and get it checked",
      "text": "A sharp pain, pain that spreads, numbness, swelling, a joint that gives way, or a sudden pull or pop."
    },
    {
      "label": "Stop now",
      "text": "Chest pain, dizziness, a heartbeat that races or skips, or breathing that doesn't feel right. Get it looked at before you train again. Told to be careful with hard exercise? Check with your doctor first."
    },
    {
      "label": "First time",
      "text": "Do two sets of each move and see how you feel in two days."
    }
  ],
