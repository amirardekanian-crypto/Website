  "focusTag": "Trunk Control & Rotation",
  "intro": [
    "Twenty minutes on the middle of you. Rotation first while you are fresh, then the bracing work that stops the hips and ribs cheating.",
    "Slow beats fast on all of it. You are teaching the trunk to hold still while everything around it turns, which is what a forehand actually asks for."
  ],
  "blocks": [
    {
      "title": "Activation & Prep",
      "icon": "🔥",
      "exercises": [
        {
          "type": "simple",
          "name": "March on the Spot",
          "videoUrl": null,
          "chips": [
            {
              "label": "2 minutes",
              "style": "dark"
            }
          ],
          "cues": {
            "good": [
              "Knee up, opposite arm back",
              "Enough to get warm, no more"
            ],
            "bad": [
              "Standing still between reps"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Cat-Cow",
          "videoUrl": null,
          "chips": [
            {
              "label": "8 Reps"
            }
          ],
          "cues": {
            "good": [
              "Move slowly between the two shapes",
              "Breathe with it"
            ],
            "bad": [
              "Rushing between the two shapes"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Open Book",
          "videoUrl": null,
          "chips": [
            {
              "label": "8 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Knees stacked and together, open the top arm",
              "Feel the turn in the ribs"
            ],
            "bad": [
              "Letting the top knee lift"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Glute Bridge",
          "videoUrl": null,
          "chips": [
            {
              "label": "12 Reps"
            }
          ],
          "cues": {
            "good": [
              "Push through the heels until the hips are level",
              "Feel the glutes switch on"
            ],
            "bad": [
              "Arching the lower back at the top"
            ]
          },
          "note": "Rotation gets its power from the hips, so wake them first."
        }
      ]
    },
    {
      "title": "Rotation",
      "icon": "⚡",
      "exercises": [
        {
          "type": "standard",
          "name": "Half-Kneeling Rotation",
