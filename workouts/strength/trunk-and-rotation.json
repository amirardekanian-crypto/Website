          "restSec": 45,
          "chips": [
            {
              "label": "3 Sets",
              "style": "yellow"
            },
            {
              "label": "×8 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Turn the ribs and keep the hips square",
              "Squeeze the back glute to lock the hips"
            ],
            "bad": [
              "The hips turning with the shoulders"
            ]
          }
        },
        {
          "type": "standard",
          "name": "Standing Chop",
          "videoUrl": null,
          "restSec": 45,
          "chips": [
            {
              "label": "3 Sets",
              "style": "yellow"
            },
            {
              "label": "×10 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Chop from high on one side to low on the other",
              "Let the back heel turn — the shot starts at the ground"
            ],
            "bad": [
              "Arms only, with the feet glued to the floor"
            ]
          },
          "note": "With a ball and a wall, throw it instead — same movement, more intent."
        }
      ]
    },
