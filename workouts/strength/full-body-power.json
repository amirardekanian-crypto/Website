            { "label": "×5 Reps" },
            { "label": "RPE 7-8" }
          ],
          "cues": {
            "good": [
              "Brace before every rep, then sit between the hips",
              "Same depth on the last rep as the first",
              "Leave two or three reps in the tank. This is not a testing day"
