            "bad": [
              "Chest collapsing forward out of the bottom",
              "Knees caving in as it gets heavy",
              "Cutting rest short — three minutes is the prescription"
            ]
          }
        },
        {
          "type": "standard",
          "name": "Barbell Romanian Deadlift",
          "videoUrl": null,
          "restSec": 150,
          "chips": [
            { "label": "3 Sets", "style": "yellow" },
            { "label": "×8 Reps" },
            { "label": "RPE 7" }
          ],
          "cues": {
            "good": [
              "Push the hips back, bar close to the legs, flat back",
              "Stop where your hamstrings stop, not where the floor is",
              "Squeeze the glutes to stand up"
            ],
            "bad": [
              "Rounding the back to reach lower",
              "Turning it into a squat by bending the knees"
            ]
          }
        }
