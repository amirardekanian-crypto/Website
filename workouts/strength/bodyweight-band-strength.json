  "intro": [
    "Legs and glutes with a band and a chair. No gym needed, and it bites plenty if you slow the lowering down.",
    "Straight sets throughout, nothing paired up. The two single-leg lifts are the session, so they get full rest and your full attention."
  ],
  "before": [
    {
      "label": "Not today",
      "text": "A sore ankle, knee, hip, hamstring, groin or Achilles, or an injury in the last month? Get it looked at first."
    },
    {
      "label": "Stop and get it checked",
      "text": "A sharp pain, pain that spreads, numbness, swelling, a joint that gives way, or a sudden pull or pop."
    },
    {
      "label": "Stop now",
      "text": "Chest pain, dizziness, a heartbeat that races or skips, or breathing that doesn't feel right. Get it looked at before you train again. Told to be careful with hard exercise? Check with your doctor first."
    },
    {
      "label": "A day or two later",
      "text": "Far more sore than normal, or your pee goes dark? Get it checked the same day."
    },
    {
      "label": "Check the kit",
      "text": "Check the band for nicks and tears first. A band that snaps can hit your face."
    },
    {
      "label": "Keep clear",
      "text": "48 hours away from another hard leg session, and not the day before a match."
    },
    {
      "label": "First time",
      "text": "Do two sets of the split squat and the single-leg deadlift, and see how you feel in two days."
    }
  ],
