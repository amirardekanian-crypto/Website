  "focusTag": "Ankles, Hips, Upper Back",
  "blocks": [
    {
      "title": "Spine & Ribs",
      "icon": "🧘",
      "exercises": [
        {
          "type": "simple",
          "name": "Cat-Cow",
          "videoUrl": null,
          "chips": [
            { "label": "10 Reps" }
          ],
          "cues": {
            "good": [
              "One vertebra at a time, breathe with the movement",
              "Out as you round, in as you arch"
            ],
            "bad": [
              "Snapping between the two shapes"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Open Book",
          "videoUrl": null,
          "chips": [
            { "label": "8 Reps / side" }
          ],
          "cues": {
            "good": [
              "On your side, knees stacked, open the top arm and follow it with your eyes",
              "Knees stay together. The turn comes from the ribs, not the hips",
              "Your serve and your forehand both live here"
            ],
            "bad": [
              "Letting the top knee lift so the hips rotate instead"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Thread the Needle",
          "videoUrl": null,
          "chips": [
            { "label": "6 Reps / side" }
          ],
          "cues": {
            "good": [
              "On all fours, reach one arm under the other and let the shoulder settle to the floor",
              "Then reach it back up to the ceiling and open the chest"
            ],
            "bad": [
              "Letting the hips drift away from over the knees"
            ]
          }
        }
      ]
    },
    {
      "title": "Hips",
      "icon": "🦵",
      "exercises": [
        {
          "type": "simple",
          "name": "90/90 Hip Switch",
          "videoUrl": null,
          "chips": [
            { "label": "8 Reps / side" }
          ],
          "cues": {
            "good": [
              "Both knees at ninety, rotate them slowly to the other side",
              "Chest tall, no hands if you can",
              "Go only as far as you own without pushing"
            ],
            "bad": [
              "Forcing the knees down with your hands"
            ]
          }
        },
        {
          "type": "simple",
          "name": "World's Greatest Stretch",
          "videoUrl": null,
          "chips": [
            { "label": "5 Reps / side" }
          ],
          "cues": {
            "good": [
              "Drive the back hip towards the floor, then rotate and reach tall",
              "Hip and upper back in one movement, which is why it earns its name"
            ],
            "bad": [
              "Rotating before the hip has opened"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Couch Stretch",
          "videoUrl": null,
          "chips": [
            { "label": "45 sec / side" }
          ],
          "cues": {
            "good": [
              "Back foot up on a sofa or wall, squeeze the back glute and stand tall",
              "The glute squeeze is the stretch. Without it you are just arching your back",
              "The front of the hip is what hours in a low stance takes from you"
            ],
            "bad": [
              "Arching the lower back to get deeper",
              "Holding your breath"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Deep Squat Hold",
          "videoUrl": null,
          "chips": [
            { "label": "60 sec", "style": "dark" }
          ],
          "cues": {
            "good": [
              "Sit into the bottom of a squat and stay there, elbows inside the knees",
              "Hold a door frame for balance if your heels lift",
              "Breathe. Let it settle rather than fighting it"
            ],
            "bad": [
              "Bouncing to get lower"
            ]
          }
        }
      ]
    },
    {
      "title": "Ankles & Shoulders",
      "icon": "🦶",
      "exercises": [
        {
          "type": "simple",
          "name": "Ankle Dorsiflexion Rocks",
          "videoUrl": null,
          "chips": [
            { "label": "10 Reps / side" }
          ],
          "cues": {
            "good": [
              "Half-kneeling, drive the knee forward over the toes, heel glued down",
              "Stiff ankles are the first thing that limits a split-step"
            ],
            "bad": [
              "Letting the heel lift",
              "Letting the arch collapse inward"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Shoulder Cross-Body Swings",
          "videoUrl": null,
          "chips": [
            { "label": "10 Reps / side" }
          ],
          "cues": {
            "good": [
              "Swing the arm across the body and back open, relaxed and rhythmic",
              "Let the upper back turn with it"
            ],
            "bad": [
              "Forcing the end range"
            ]
          }
        }
      ]
    }
  ]
}
