{
  "id": "daily-flow",
  "title": "Daily Mobility Flow",
  "category": "mobility",
  "countsAs": "mobility",
  "duration": "15 min",
  "equipment": "Bodyweight",
  "focusTag": "Ankles, Hips, Upper Back",
  "intro": [
    "Fifteen minutes on the four things a racket player actually loses: ankles, hips, upper back and shoulders.",
    "Short enough to do every day, and that is the point — this works by being frequent rather than by being hard. Go to the edge of what you own and breathe there, rather than forcing past it."
  ],
  "blocks": [
    {
      "title": "Spine & Ribs",
      "icon": "🧘",
      "exercises": [
        {
          "type": "simple",
          "name": "Cat-Cow",
          "videoUrl": null,
          "chips": [
            {
              "label": "10 Reps"
            }
          ],
          "cues": {
            "good": [
              "Move slowly, one vertebra at a time",
              "Breathe with it, out as you round"
            ],
            "bad": [
              "Snapping between the two shapes"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Open Book",
          "videoUrl": null,
          "chips": [
            {
              "label": "8 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Knees stacked and together, open the top arm and follow it with your eyes",
              "Feel the turn in your ribs"
            ],
            "bad": [
              "Letting the top knee lift"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Thread the Needle",
          "videoUrl": null,
          "chips": [
            {
              "label": "6 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Reach one arm under the other and let the shoulder settle",
              "Feel it across the back of the shoulder blade"
            ],
            "bad": [
              "Letting the hips drift away from over the knees"
            ]
          }
        }
      ]
    },
    {
      "title": "Hips",
      "icon": "🦵",
      "exercises": [
        {
          "type": "simple",
          "name": "90/90 Hip Switch",
          "videoUrl": null,
          "chips": [
            {
              "label": "8 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Rotate both knees slowly to the other side, chest tall",
              "Go only as far as you own without pushing"
            ],
            "bad": [
              "Forcing the knees down with your hands"
            ]
          }
        },
        {
          "type": "simple",
          "name": "World's Greatest Stretch",
          "videoUrl": null,
          "chips": [
            {
              "label": "5 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Drive the back hip towards the floor, then rotate and reach tall",
              "Hip and upper back in one movement"
            ],
            "bad": [
              "Rotating before the hip has opened"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Couch Stretch",
          "videoUrl": null,
          "chips": [
            {
              "label": "45 sec / side"
            }
          ],
          "cues": {
            "good": [
              "Back foot up on a sofa or wall, squeeze the back glute and stand tall",
              "Feel the front of the back hip, never the lower back"
            ],
            "bad": [
              "Arching the lower back to get deeper"
            ]
          }
        },
        {
          "type": "simple",
          "name": "Deep Squat Hold",
          "videoUrl": null,
          "chips": [
            {
              "label": "60 sec",
              "style": "dark"
            }
          ],
          "cues": {
            "good": [
              "Sit into the bottom of a squat, elbows inside the knees",
              "Let it settle rather than fighting it"
            ],
            "bad": [
              "Bouncing to get lower"
            ]
          }
        }
      ]
    },
    {
      "title": "Ankles & Shoulders",
      "icon": "🦶",
      "exercises": [
        {
          "type": "simple",
          "name": "Ankle Dorsiflexion Rocks",
          "videoUrl": null,
          "chips": [
            {
              "label": "10 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Half-kneeling, drive the knee forward over the toes",
              "Heel stays glued down"
            ],
            "bad": [
              "Letting the arch collapse inward"
            ]
          },
          "note": "Stiff ankles are the first thing that limits a split-step."
        },
        {
          "type": "simple",
          "name": "Shoulder Cross-Body Swings",
          "videoUrl": null,
          "chips": [
            {
              "label": "10 Reps / side"
            }
          ],
          "cues": {
            "good": [
              "Swing the arm across the body and back open, relaxed",
              "Let the upper back turn with it"
            ],
            "bad": [
              "Forcing the end range"
            ]
          }
        }
      ]
    }
  ]
}
