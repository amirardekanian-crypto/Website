    echo ""
    echo "pre-commit: BLOCKED — Amir no longer plays like a person against the test bots (details above). Move a number in the AMIR block of assets/js/rally.js, then run: node scripts/test_rally_sim.js"
    failed=1
  else
    echo "pre-commit: Off the Glass OK."
  fi
fi

