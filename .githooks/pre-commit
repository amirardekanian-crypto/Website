#!/bin/sh
# Twenty-two guards. Each runs only when its own files are staged, so a commit that
# touches none of them costs nothing.
#
# ── 1. habits.html must actually boot ────────────────────────────────────────
# Why: an HTML comment sitting inside a JS template literal in habits.html
# has broken the live app TWICE in one afternoon (2026-08-01) — a stray
# backtick in the comment prose silently terminates the template literal,
# the parser can resync into something that still "parses" but never
# reaches the app's own boot call, and the site sits on its loading screen
# forever with nothing in the console. It even reached production once,
# via a commit nobody in this session ran on purpose — which is exactly the
# case a hook protects against that "remember to test" does not: it runs on
# every commit, regardless of who or what created it.
#
# ── 2. Article web pages must match their articles (added 2026-09-13) ────────
# Why: Amir's standing rule is "every time I add an article it updates the
# website as well". scripts/build_article_pages.py turns articles/*.json, plus
# the reviewed *.fa.json translations, into /en/articles/ and /fa/articles/
# pages and sitemap.xml. This blocks a commit that changes an article without
# rebuilding its pages, adds one with no Farsi translation, or leaves a Farsi
# translation behind its revised English — whichever session or tool made it.
# Root *.html is in the trigger too, because a new public page changes the sitemap.
#
# NOTE: both checks read the WORKING-TREE copy, not the exact staged blob.
# That is a real gap if you ever `git add -p` a partial hunk — for this
# repo's actual workflow (always whole files, together) it is not one in
# practice. If that ever changes, check the staged blob instead:
#   git show :habits.html > /tmp/staged.html && check_js_syntax.py /tmp/staged.html

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

PY=python
command -v python >/dev/null 2>&1 || PY=python3

failed=0

# ── 1. habits.html ───────────────────────────────────────────────────────────
if git diff --cached --name-only --diff-filter=ACM | grep -qx "habits.html"; then
  echo "pre-commit: habits.html changed — checking it actually boots..."

  "$PY" scripts/check_js_syntax.py habits.html
  syntax_status=$?

  "$PY" scripts/check_habits_boots.py habits.html
  boot_status=$?

  if [ $syntax_status -ne 0 ] || [ $boot_status -ne 0 ]; then
    echo ""
    echo "pre-commit: BLOCKED — habits.html failed the check(s) above."
    echo "Fix it, or in a genuine emergency: git commit --no-verify"
    echo "(but that is what let the last one through, so read the errors first)."
    failed=1
  else
    echo "pre-commit: habits.html OK."
  fi
fi

# ── 2. article pages ─────────────────────────────────────────────────────────
if git diff --cached --name-only --diff-filter=ACMD \
     | grep -qE '^(articles/|en/articles/|fa/articles/|scripts/build_article_pages\.py$|sitemap\.xml$|robots\.txt$|[^/]+\.html$|(tennis|tennis-testing)/index\.html$)'; then
  echo "pre-commit: articles or public pages changed — checking the website pages match..."
  if "$PY" scripts/build_article_pages.py --check; then
    echo "pre-commit: article pages OK."
  else
    echo ""
    echo "pre-commit: BLOCKED — the article web pages are out of date (details above)."
    echo "Run: python scripts/build_article_pages.py   and stage what it writes."
    echo "A missing or stale Farsi translation needs Amir's OK first: see .claude/skills/article/SKILL.md."
    failed=1
  fi
fi

# ── 3. program.html circuit logging (added 2026-09-15) ───────────────────────
# Why: a circuit decides whether the athlete sees a weight field per item and an
# RPE row per round, and getting it wrong is silent BOTH ways — a prep circuit
# demanding kilograms for a mobility drill (live on 13 circuits across 4
# athletes until this was fixed), or a superset recording nothing, which cost
# one athlete's Cycle 1 the per-set baseline on 5 of 16 exercises. The specific trap
# the check guards: deciding prep-ness from blockCategory(), whose positional
# fallback makes "Core" at index 3 read as the warm-up block.
if git diff --cached --name-only --diff-filter=ACM | grep -qx "program.html"; then
  echo "pre-commit: program.html changed — checking circuit logging rules..."
  if "$PY" scripts/check_circuit_logging.py; then
    echo "pre-commit: circuit logging OK."
  else
    echo ""
    echo "pre-commit: BLOCKED — program.html failed the circuit logging check above."
    failed=1
  fi
fi

# ── 4. the course app's cache stamps (added 2026-09-15) ──────────────────────
# Why: tennis/app/ is normally deployed, already stamped, from the private
# tps-content repo, but it can be edited here too (the demo was, 2026-09-15).
# Its service worker answers from cache first: a change committed under an
# unchanged sw.js VERSION never reaches a phone that already has the app.
if git diff --cached --name-only --diff-filter=ACMD | grep -q '^tennis/app/'; then
  echo "pre-commit: tennis/app changed — checking its cache stamps..."
  if ! "$PY" scripts/stamp_tps_app.py --check; then
    echo ""
    echo "pre-commit: BLOCKED — run: python scripts/stamp_tps_app.py   and stage what it writes."
    failed=1
  fi
fi

# ── 5. the prescription format (added 2026-09-20) ──────────────────────
# Why: rxOf() — which decides what an exercise's prescription MEANS — exists
# twice, inline in program.html (the offline PWA, deliberately self-contained)
# and in assets/js/chips.js (which coach.html loads). If the two drift, the
# coach's dashboard and the athlete's phone show different prescriptions for the
# same exercise and NOTHING ERRORS. Same class of bug as the xp_rules/habits.html
# pair CLAUDE.md warns about, and caught the same way: run fixtures through both
# copies and diff. It also audits every rx in the Train library.
if git diff --cached --name-only --diff-filter=ACM      | grep -qE '^(program\.html|coach\.html|assets/js/chips\.js|workouts/|scripts/(check_rx|migrate_rx)\.js)'; then
  echo "pre-commit: prescription code or data changed — checking rx..."
  if node scripts/check_rx.js && node scripts/test_coach_compare.js >/dev/null; then
    echo "pre-commit: rx OK."
  else
    echo ""
    echo "pre-commit: BLOCKED — the rx check failed (details above)."
    echo "If program.html and assets/js/chips.js disagree, fix BOTH — they are one model in two files."
    failed=1
  fi
fi

# ── 6. no athlete ids in the public coaching docs (added 2026-09-26) ─────────
# Why: this repo is PUBLIC. The coaching logs left it on 2026-09-07 for exactly that
# reason, but the pipeline's own skill files kept naming athletes, two of them with
# wrist and shoulder details, until the 2026-09-26 audit scrubbed them. The ids live
# in .claude/athlete-ids.local, which is gitignored because a committed list would be
# the leak itself (one id per line; /athlete-intake appends each new one). Only lines
# being ADDED are checked, so an old mention elsewhere never blocks a commit. A clone
# without the list skips this guard.
ids_file=".claude/athlete-ids.local"
if [ -f "$ids_file" ]; then
  staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(\.claude/|\.githooks/)' | grep -vx "$ids_file")
  if [ -n "$staged" ]; then
    # Lower-case both sides instead of `grep -i`: Git for Windows' grep aborts on -i with
    # -F -f (found testing this guard, 2026-09-26), and an aborted grep reads as "no hits".
    pats=$(mktemp)
    tr -d '\r' < "$ids_file" | grep -v '^[[:space:]]*$' | tr 'A-Z' 'a-z' > "$pats"
    hits=$(git diff --cached -U0 -- $staged | grep -E '^\+[^+]' | tr 'A-Z' 'a-z' | grep -oFf "$pats" | sort -u)
    rm -f "$pats"
    if [ -n "$hits" ]; then
      echo ""
      echo "pre-commit: BLOCKED — athlete ids in lines being added to public coaching files:"
      echo "$hits" | sed 's/^/  /'
      echo "Write 'one athlete' or the next 'Athlete <letter>' instead; their record lives in public.coaching_logs."
      failed=1
    fi
  fi
fi

# ── 7. the coaching rulebook holds together (added 2026-09-26) ───────────────
# Why: one rule used to live in up to ten places, and a stale copy reached athletes.
# Each rule now has one owner, a numbered line in the rule index at the top of
# .claude/COACHING-PRINCIPLES.md, and everything else cites its ID. This fails a
# rule with no story, a skill citing an ID that doesn't exist, and an index "Check"
# column that scripts/check_program.py doesn't actually back.
if git diff --cached --name-only --diff-filter=ACMD \
     | grep -qE '^(\.claude/(COACHING-PRINCIPLES|COACHING-HOWTO)\.md|\.claude/(skills|agents)/|scripts/check_(program|rule_index)\.py|CLAUDE\.md|SCHEMA\.md)'; then
  echo "pre-commit: coaching rules or their citations changed — checking the rule index..."
  if ! "$PY" scripts/check_rule_index.py; then
    echo ""
    echo "pre-commit: BLOCKED — the rule index and its citations disagree (details above)."
    failed=1
  fi
fi

# ── 8. the checker's own tests (added 2026-09-26) ────────────────────────────
# Why: scripts/check_program.py is what holds every programme to the house rules before engage
# writes a word, and until the audit its tests lived in one session's scratchpad. A change to the
# checker, the rule guard, the app's shared rules (chips.js) or the principles runs all of them on
# a made-up athlete, so a check that silently stops working is caught before it ships.
# The build script (2026-10-17) uses the checker's helpers and must build what the checker passes,
# so its tests run here too.
if git diff --cached --name-only --diff-filter=ACMD \
     | grep -qE '^(scripts/(check_program|check_rule_index|test_check_program|name_cases_sql|spec_to_workouts|test_spec_to_workouts)\.py|scripts/name_cases\.json|assets/js/chips\.js|\.claude/COACHING-PRINCIPLES\.md)$'; then
  echo "pre-commit: the programme checker, the build script or their rules changed — running their tests..."
  if ! "$PY" scripts/test_check_program.py; then
    echo ""
    echo "pre-commit: BLOCKED — the checker's tests failed (details above)."
    failed=1
  fi
  if ! "$PY" scripts/test_spec_to_workouts.py; then
    echo ""
    echo "pre-commit: BLOCKED — the build script's tests failed (details above)."
    failed=1
  fi
fi

# ── 9. the set-log line grammar (added 2026-09-26) ───────────────────────────
# Why: program.html's buildSessionData() writes every session as text
# ("Set 2: 2×20 ×8 @7 ✓") and two readers parse it back, parseSetLine() in
# coach.html and parseSetText() in program.html. A weight typed with × was read
# as the rep count by both until 2026-09-26, and nothing errored. This runs the
# real writer through both readers and checks every set comes back as it went in.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(program\.html|coach\.html|scripts/check_setlog\.js)$'; then
  echo "pre-commit: set-log writer or readers changed — checking the round trip..."
  if node scripts/check_setlog.js >/dev/null; then
    echo "pre-commit: set log OK."
  else
    node scripts/check_setlog.js 2>&1 | grep -E 'FAIL|could not find|Error' | head -20
    echo ""
    echo "pre-commit: BLOCKED — a logged set no longer reads back as it was written (details above)."
    echo "buildSessionData(), parseSetLine() and parseSetText() are one grammar: change all three."
    failed=1
  fi
fi

# ── 10. the XP rules, scored twice (added 2026-09-26) ────────────────────────
# Why: the leaderboard scores from public.xp_rules (id 1) and the phone from habits.html's
# constants. When they drift, the board and the athlete's own screen disagree and nothing errors
# (XP_SYSTEM.md §8). The row can't be read from here, so supabase/xp_rules_snapshot.json is a
# committed copy of it: refresh it with --live after changing the row (the script's header).
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(habits\.html|supabase/xp_rules_snapshot\.json|scripts/check_xp_rules\.py)$'; then
  echo "pre-commit: habits.html or the xp_rules snapshot changed — checking the two scorers agree..."
  if ! "$PY" scripts/check_xp_rules.py; then
    echo ""
    echo "pre-commit: BLOCKED — habits.html and the xp_rules row disagree (details above). Change BOTH sides."
    failed=1
  fi
fi

# ── 11. the shared word lists (added 2026-09-26) ─────────────────────────────
# Why: the qualities, muscles, patterns, body parts, cost tiers, art words and the Quality mix's
# numbers are typed out in program.html, coach.html, check_program.py, the spine skill's
# draft_sql.py, the stage SQL and the database (supabase/word_lists_snapshot.json). A copy that
# drifts offers a word another copy refuses, silently.
if git diff --cached --name-only --diff-filter=ACM \
     | grep -qE '^(program\.html|coach\.html|SCHEMA\.md|scripts/check_(program|parity)\.py|\.claude/skills/spine/draft_sql\.py|supabase/(word_lists_snapshot\.json|stage3[269]_[a-z_]+\.sql)|tennis/app/app\.js)$'; then
  echo "pre-commit: a copy of the shared word lists changed — checking every copy agrees..."
  if ! "$PY" scripts/check_parity.py >/dev/null; then
    "$PY" scripts/check_parity.py | grep -E '^(DIFF|FAIL)|missing|order' | head -30
    echo ""
    echo "pre-commit: BLOCKED — the word lists disagree (details above). Change every copy."
    failed=1
  else
    echo "pre-commit: word lists OK."
  fi
fi

# ── 12. the training app's type scale (added 2026-09-27) ─────────────────────
# Why: program.html had 46 font sizes and text down to 7.5 px, because every new screen picked
# the pixel that looked right that day (Fresh Eyes DS-03). Every size is now one of seven steps
# and a field size, the --fs- tokens in its :root; a display numeral says so in a comment.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(program\.html|scripts/check_type_scale\.py)$'; then
  echo "pre-commit: program.html changed — checking its font sizes are on the type scale..."
  if ! "$PY" scripts/check_type_scale.py; then
    echo ""
    echo "pre-commit: BLOCKED — a font size is off the type scale (details above). Use a --fs- token."
    failed=1
  fi
fi

# ── 13. the website's style (added 2026-10-02) ───────────────────────────────
# Why: the website audit (Content/SITE-AUDIT.md) fixed yellow, text under 12 px, pale greys, letter-spaced
# Farsi, Google font links and white text on the paler clay, and nothing stopped them coming back. This
# fails a change that ADDS one to a public page or its shared CSS (it keeps a baseline of what already
# existed: scripts/site_style_baseline.json). Amir, 2026-10-02: "stop the commit".
if git diff --cached --name-only --diff-filter=ACM      | grep -qE '^((index|index-fa|links|proof|form|form-fa|partner-fa|coach|terms|terms-fa|privacy|404|uts-padel|etminan|etminan-en|etminan-dv)\.html|(tennis|tennis-testing)/index\.html|partials/(nav|footer)\.html|assets/css/(tokens|base|components|fa-product|fonts)\.css|assets/js/(shared|fa-nav|track)\.js|scripts/(check_site_style\.py|site_style_baseline\.json))$'; then
  echo "pre-commit: a public page or its shared CSS changed — checking the website style..."
  if ! "$PY" scripts/check_site_style.py; then
    echo ""
    echo "pre-commit: BLOCKED — the change brings back something the website audit fixed (details above)."
    failed=1
  fi
fi

# ── 14. every Library card links to its Spine entry (added 2026-10-09) ────────
# Why: a video, the cues and the About sheet live on the exercise's Spine entry, and a card reaches
# it through exId. The 42 older sessions predated the Spine: 10 of 371 cards had an exId and 180
# matched no entry, so a video Amir added in coach.html never reached them. This fails a card with no
# exId unless its name is on scripts/library_spine_baseline.json, which only shrinks.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(workouts/|scripts/(check_library_spine\.py|library_spine_baseline\.json)$)'; then
  echo "pre-commit: a Library session changed — checking every card links to the Spine..."
  if ! "$PY" scripts/check_library_spine.py; then
    echo ""
    echo "pre-commit: BLOCKED — a Library card has no exId (details above). Link it, or draft its entry with /spine."
    failed=1
  fi
fi

# ── 15. logic that exists in both the dashboard and the athlete app (added 2026-10-10) ────────
# Why: coach.html re-implements some of program.html's rules (program.html is the offline PWA and stays self-contained):
# the exercise-name tiers, a renamed lift, the Spine lookup, today's RPE target on a lower day, what the Quality check counts,
# and the check-in line the app writes and the email import reads. When one copy changes alone the coach and the athlete
# see different numbers and nothing errors; the coach.html audit (TWIN-10) found only rxOf, the set log and the word lists
# were guarded. scripts/check_twins.js cuts each pair out of both files and runs the same vectors through both. It also
# fails a change to assets/js/chips.js that keeps coach.html's hand-typed ?v= (TWIN-4): the service worker serves /assets/
# cache-first, so the old file would stay in every browser that has it. test_check_twins.js proves the guard still fails
# when a twin drifts, and runs only when the guard itself changes.
# Career Mode (added 2026-10-18): check_twins.js section 10 also holds habits.html (the five events' goals, the reward rules) to career/*.toml,
# which it reads through scripts/career_seed.py --json, and to scripts/career/reward_cases.json; sections 8 and 9 hold both apps to hold_cases.json
# and xp_cases.json. A change to any of them alone used to pass this guard unrun, so they trigger it too.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(program\.html|coach\.html|assets/js/chips\.js|scripts/(check_twins|test_check_twins)\.js|scripts/twins_stamp\.json|scripts/name_cases\.json|habits\.html|career/[^/]+\.toml|scripts/career_seed\.py|scripts/career/(hold|xp|reward)_cases\.json)$'; then
  echo "pre-commit: program.html, coach.html, habits.html, chips.js or the Career Mode files they are held to changed — checking the rules they share still agree..."
  # CHECK_TWINS_INDEX=1: read the STAGED files, the ones that will be committed. A ?v= bumped in the working tree but
  # left unstaged must not pass. The output is kept so a failure is printed once.
  twins_out=$(CHECK_TWINS_INDEX=1 node scripts/check_twins.js 2>&1)
  if [ $? -eq 0 ]; then
    echo "pre-commit: shared rules OK."
  else
    echo "$twins_out" | grep -v '^  ok ' | head -60
    echo ""
    echo "pre-commit: BLOCKED — a rule shared by coach.html and program.html, or the chips.js cache stamp, is out of step (details above)."
    failed=1
  fi
  if git diff --cached --name-only --diff-filter=ACM | grep -qE '^scripts/(check_twins|test_check_twins)\.js$'; then
    if ! node scripts/test_check_twins.js >/dev/null; then
      node scripts/test_check_twins.js | grep -v '^ok '
      echo ""
      echo "pre-commit: BLOCKED — the twin guard no longer fails when a twin drifts (details above)."
      failed=1
    fi
  fi
fi

# ── 16. a quest run's last scoring day, phone and server (added 2026-10-11) ────────────────────────────────────────────────
# Why: cancelling a quest week used to REMOVE the run, which took back the XP everyone had already earned from it (coach.html audit
# TODAY-1). Since stage55 the coach ENDS a run: it keeps an `end` day that stops the run, and a quest completed by then keeps paying.
# That bound lives twice, runEndKey() in habits.html and the qruns CTE of hab_bonus_xp() on the server, and when they differ the
# board and the phone disagree about a quest's XP and nothing errors. scripts/test_quest_runs.js cuts runEndKey out of habits.html
# and runs the vectors the SQL suite (scripts/test_spine_sql.sh, section J) runs against the server.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(habits\.html|scripts/test_quest_runs\.js)$'; then
  echo "pre-commit: habits.html changed — checking a quest run's last scoring day..."
  if ! node scripts/test_quest_runs.js >/dev/null; then
    node scripts/test_quest_runs.js | grep -v '^ok '
    echo ""
    echo "pre-commit: BLOCKED — a quest run's window in habits.html no longer matches the rule (details above). The server twin is hab_bonus_xp()'s qruns CTE (stage55)."
    failed=1
  fi
fi

# ── 17. the restore path: schema snapshot, backup list, restore generator (added 2026-10-11) ───────────────────────────────
# Why: there were no automatic backups and no way back. A restore needs (1) the database's structure, supabase/schema_snapshot.sql (generated from the live
# project by scripts/restore/), (2) a backup of the rows (coach.html's BACKUP_TABLES), and (3) the generator that turns one into the other
# (scripts/restore/restore_backup.py). When the three stop agreeing nothing errors until the day a restore is needed. scripts/test_restore_backup.py checks that
# the dashboard backs up exactly the snapshot's tables and that the generator still does its job (erased people stay erased, a login's rows follow the login,
# nothing a row says can end a quote early). The complete proof, on a real PostgreSQL, is scripts/restore/rehearse.mjs (README there); it needs PGlite, so it is
# not run here. A new stage file is only a WARNING: the snapshot is regenerated from the live project (README, "Keeping the snapshot current").
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(supabase/schema_snapshot\.sql|scripts/restore/[^/]+|scripts/test_restore_backup\.py|coach\.html)$'; then
  echo "pre-commit: the restore path changed — checking the snapshot, the backup list and the generator agree..."
  if ! restore_out=$("$PY" scripts/test_restore_backup.py 2>&1); then
    echo "$restore_out" | grep -v '^ok '
    echo ""
    echo "pre-commit: BLOCKED — the restore path no longer agrees with itself (details above). A new table goes in coach.html BACKUP_TABLES and in the snapshot."
    failed=1
  else
    echo "pre-commit: restore path OK."
  fi
fi
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^supabase/stage[0-9]+[a-z]?_[A-Za-z0-9_]+\.sql$'    && ! git diff --cached --name-only | grep -qx 'supabase/schema_snapshot.sql'; then
  echo "pre-commit: WARNING — a supabase/stage*.sql file is staged but supabase/schema_snapshot.sql is not."
  echo "            If that stage was applied to the live project, regenerate the snapshot (scripts/restore/README.md, \"Keeping the snapshot current\")"
  echo "            and stage it, or the restore path will rebuild the old structure. Not blocking: a stage file that was only drafted needs nothing."
fi

# ── 18. a wrong phone clock must not break sign-in (added 2026-10-12) ───────────────────────────────────────────────────────
# Why: supabase-js decides by the phone's clock whether a token has expired. A phone 89 minutes behind (an Irancell iPhone in the 2026-10-04 reach reports) kept sending an
# hour-old token, the server answered 401 "JWT expired", and program.html read that as a refusal: "Plan not available", and the saved plan thrown away (SITE-AUDIT 25b).
# Each app now gives createClient a fetch, fetchRetryExpired(), that refreshes the session once on that answer and repeats the call. It exists four times (program.html,
# habits.html, tennis/app/app.js, tennis-testing/app/app.js) and a copy that drifts, or a client made without it, brings the symptom back for the people it hit.
# scripts/test_fetch_retry.js cuts the function out of all four, requires one text, and runs the real supabase-js through it against a mock server. No browser needed.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^(program\.html|habits\.html|tennis/app/app\.js|tennis-testing/app/app\.js|scripts/test_fetch_retry\.js)$'; then
  echo "pre-commit: an app's Supabase client changed — checking the retry on an expired token is in every copy..."
  if ! retry_out=$(node scripts/test_fetch_retry.js 2>&1); then
    echo "$retry_out" | grep -v '^ok '
    echo ""
    echo "pre-commit: BLOCKED — fetchRetryExpired() differs between the four apps, is missing from a createClient, or no longer does its job (details above)."
    failed=1
  else
    echo "pre-commit: expired-token retry OK."
  fi
fi

# ── 19. skill and agent headers parse as YAML (added 2026-10-17) ────────────────────────────────────────────────────────────
# Why: an unquoted ": " inside a `description:` is not valid YAML, so the Claude desktop app drops the skill's description and shows its first heading instead,
# which is what Claude reads to pick a skill. Seven SKILL.md files had it and nothing errored (the agent athlete-brief.md too). scripts/check_skill_headers.py
# needs only the standard library: each header must have name and description, a quoted description must close, an unquoted one holds no ": " and does not start
# with a YAML indicator. The fix is always the same: wrap the description value in double quotes. test_check_skill_headers.py proves the guard still fails
# on each fault, and runs only when the guard itself changes.
hdr_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(\.claude/skills/[^/]+/SKILL\.md|\.claude/agents/[^/]+\.md)$')
if [ -n "$hdr_files" ]; then
  echo "pre-commit: a skill or agent header changed — checking it parses as YAML..."
  if ! hdr_out=$("$PY" scripts/check_skill_headers.py $hdr_files 2>&1); then
    echo "$hdr_out"
    echo ""
    echo "pre-commit: BLOCKED — a skill or agent header will not parse (details above). Wrap its description value in double quotes (escape any \" inside) and change nothing else."
    failed=1
  else
    echo "pre-commit: skill and agent headers OK."
  fi
fi
if git diff --cached --name-only --diff-filter=ACM | grep -qE '^scripts/(check|test_check)_skill_headers\.py$'; then
  echo "pre-commit: the header guard changed — running its tests..."
