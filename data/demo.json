  "cycles": [
    {
      "num": 1,
      "name": "Foundation Forge",
      "tagline": "Build the Platform",
      "weeks": "Weeks 1–5",
      "focuses": [
        "Build foundational movement quality across the squat, hinge, push, and pull patterns.",
        "Establish an aerobic base and baseline work capacity.",
        "Reinforce shoulder health and core control before loading begins."
      ]
    },
    {
      "num": 2,
      "name": "Load & Build",
      "tagline": "Earn the adaptation",
      "weeks": "Weeks 6–10",
      "focuses": [
        "Progress the squat and hinge with real, trackable load.",
        "Build the rotational power that sits behind every shot.",
        "Armour the shoulder so the serve holds up all season.",
        "Sharpen change of direction — the first step to the ball."
      ],
      "message": {
        "paragraphs": [
          "This is where the body starts genuinely changing. Foundation Forge taught your nervous system how to move; this cycle teaches it how to produce force.",
          "Every strength lift now has a concrete rep and tempo prescription. You'll feel weights get heavier and progress become visible session by session. The goal is not to chase fatigue — it is to chase clean, heavy reps at the tempos written.",
          "Jumps and throws come first in every session, while you're fresh. Treat the bounds and med-ball throws as tennis practice, not conditioning — every rep is maximum intent, then full recovery."
        ],
        "outcomes": [
          "Measurable strength gains in the back squat and Romanian deadlift",
          "Sharper, more controlled first step and change of direction",
          "Confident, pain-free overhead pressing and serving",
          "Rotational power that shows up in your groundstrokes"
        ]
      }
    },
    {
      "num": 3,
      "name": "Power Translation",
      "tagline": "Turn strength into speed",
      "weeks": "Weeks 11–15",
      "focuses": [
        "Convert strength into usable court speed through contrast training.",
        "Increase rate of force development in lower-body plyometrics.",
        "Progress rotational power with heavier med balls and faster tempos."
      ],
      "teaser": {
        "subtitle": "Strength becomes court speed.",
        "paragraphs": [
          "Cycle 3 is where the weights get lighter and the movements get faster. You've built the platform; now we express it.",
          "Expect more contrast work: a heavy squat paired with a jump, a heavy press paired with a med-ball throw. The strength carries over — but only if you chase speed of execution, not load.",
          "This is the cycle where on-court performance starts to visibly change."
        ]
      }
    },
    {
      "num": 4,
      "name": "Peak Performance",
      "tagline": "Sharpen every output",
      "weeks": "Weeks 16–20",
      "focuses": [
        "Maintain strength with lower volume, higher intent.",
        "Maximise rotational and reactive power.",
        "Tennis-specific change-of-direction and deceleration work."
      ]
    },
    {
      "num": 5,
      "name": "Active Recovery",
      "tagline": "Consolidate before the next block",
      "weeks": "Weeks 21–24",
      "focuses": [
        "Reduce volume by 40–50% and remove high-impact plyometrics.",
        "Prioritise tissue quality, mobility, and sleep.",
        "Reassess movement and plan the next six-month block."
      ]
    }
  ],
