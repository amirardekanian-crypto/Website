# Secrets — NEVER push
.notion_token
# Supabase service_role key, used by backup_supabase.py. It bypasses every row-level
# policy, so a leak is full read/write on every athlete's data.
.supabase_key

# Patcher intermediate output and audit files — produced locally, not part of the site
data/jsons_patched/
data/Jsons_original/
data/patch_report.txt
data/unresolved_movements.txt
data/patch_jsons_1.py.txt

# Athlete JSONs are NO LONGER pushed. Programmes live in the Supabase `programs`
# table; program.html, habits.html and coach.html all read them from there. The
# coaching pipeline still WRITES data/<id>.json as a local working file — publish it
# with coach.html → Athletes → "Publish programme file". Committing one would put
# every programme, and the athlete keys 30 of them carry, back on the public web.
data/*.json
!data/.gitkeep

# Coaching logs are coach-only rationale written ABOUT an athlete, and this repo is
# PUBLIC. They were tracked here for months, world-readable, despite each file opening
# with "Never published" (that meant "not shown in the athlete's app"). They live in
# public.coaching_logs now - read and written from coach.html. Keep working copies here
# if you like; they must never be committed again.
.claude/coaching-log/

# Every athlete id, one per line, for the pre-commit guard that keeps them out of the
# public coaching docs (.githooks/pre-commit, guard 6). Committing the list would be
# the very leak it guards against. /athlete-intake appends each new id.
.claude/athlete-ids.local

# Local database backups (backup_supabase.py). Dated copies of every athlete's
# programme, training history and coaching log — the whole point is that they live
# on Amir's PC and nowhere else. The script writes to ~/AA-Backups by default, well
# outside this repo; this entry only catches the case where --out is pointed inside.
AA-Backups/
__pycache__/

# Reel exports (MP4 + cover frames): big, and regenerated by .claude/skills/reel/tools/render_mp4.js.
Content/*/export/

# Video archive (Content/video-archive): finished ad exports are big and rebuildable, and private/ holds real people and restricted likenesses.
# Both stay OneDrive-only. The catalogue, posters, generated clips and app clips ARE tracked. See Content/video-archive/README.md.
Content/video-archive/reels/
Content/video-archive/private/
